# linux-nano: changes on top of ALARM's linux-aarch64 config (merged in prepare()).
# Tegra210 EMC driver in tree (was an out-of-tree build of the same source + 0101).
CONFIG_TEGRA_MC=y
CONFIG_TEGRA210_EMC=m
# Fan PWM in tree (was a DKMS module).
CONFIG_PWM_TEGRA=m
# Real-time clocks: the SoC's (wakes the board from suspend) and the MAX77620 PMIC's. ALARM's config
# has neither, so there was no wake alarm.
CONFIG_RTC_DRV_TEGRA=m
CONFIG_RTC_DRV_MAX77686=m
# Without a battery the PMIC clock restarts in 2000 after a power cut, and it loads after systemd has
# set a plausible date: leave the system clock to systemd-timesyncd.
# CONFIG_RTC_HCTOSYS is not set
# Memory on a 4 GB board with an SD-card root:
# Multi-gen LRU reclaims by page age and, with min_ttl_ms (set by jetson-nano-board), keeps the
# working set instead of thrashing (as ChromeOS does on small devices).
CONFIG_LRU_GEN=y
CONFIG_LRU_GEN_ENABLED=y
# zram compressors: Omarchy's zram setup asks for zstd; lz4 is the fast alternative. ALARM's
# config builds lzo only, so zram silently fell back to lzo-rle.
CONFIG_ZRAM_BACKEND_LZ4=y
CONFIG_ZRAM_BACKEND_ZSTD=y
CONFIG_ZRAM_DEF_COMP_ZSTD=y
# GCC plugins are tied to the exact compiler that built the kernel: with them, out-of-tree modules
# (nvgpu-nano) only build with that same gcc. Off so a cross-built kernel (gcc 14) still takes
# modules built on the Nano (gcc 16). Only latent_entropy/stackleak-style hardening depends on it.
# CONFIG_GCC_PLUGINS is not set
