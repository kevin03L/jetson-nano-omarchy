From: kevin03L <kevin03L@users.noreply.github.com>
Subject: [PATCH] clk: tegra: dfll-fcpu: optional CPU clock above the SKU's on Tegra210

clk_tegra124_dfll_fcpu.max_khz= offers the CPU clocks of the voltage table that the chip's SKU leaves
out: 1683 MHz at 1195 mV on a Jetson Nano (1555.5 MHz at 1162 mV otherwise), NVIDIA's values for the
Tegra210 SKUs of speedo ID 8. Without the parameter nothing changes.

Co-Authored-By: Claude Opus 5.5 <noreply@anthropic.com>
---
--- a/drivers/clk/tegra/clk-tegra124-dfll-fcpu.c
+++ b/drivers/clk/tegra/clk-tegra124-dfll-fcpu.c
@@ -11,6 +11,7 @@
 #include <linux/cpu.h>
 #include <linux/err.h>
 #include <linux/kernel.h>
+#include <linux/moduleparam.h>
 #include <linux/init.h>
 #include <linux/of.h>
 #include <linux/platform_device.h>
@@ -325,6 +326,9 @@
 		{          0UL,	{       0, 0, 0 } }, \
 	}
 
+/* As the table of the Tegra210 SKUs with 1683 MHz (speedo ID 8) */
+#define TEGRA210_CPU_OC_MAX_MV	1195
+
 static struct cvb_table tegra210_cpu_cvb_tables[] = {
 	{
 		.speedo_id = 10,
@@ -654,8 +658,18 @@
 	return 0;
 }
 
+/*
+ * Tegra210 only. 0: the chip's SKU decides. Otherwise the highest CPU clock
+ * offered, if it is above the SKU's; its voltage comes from the same table.
+ */
+static unsigned int max_khz;
+module_param(max_khz, uint, 0444);
+MODULE_PARM_DESC(max_khz, "Tegra210: highest CPU clock in kHz (0: the chip's own)");
+
 static int tegra124_dfll_fcpu_probe(struct platform_device *pdev)
 {
+	struct cvb_table *table;
+	size_t i;
 	int process_id, speedo_id, speedo_value, err;
 	struct tegra_dfll_soc_data *soc;
 	const struct dfll_fcpu_data *fcpu_data;
@@ -695,6 +709,19 @@
 
 	soc->max_freq = fcpu_data->cpu_max_freq_table[speedo_id];
 
+	if (fcpu_data->cpu_cvb_tables == tegra210_cpu_cvb_tables &&
+	    max_khz * 1000UL > soc->max_freq) {
+		soc->max_freq = max_khz * 1000UL;
+		for (i = 0; i < ARRAY_SIZE(tegra210_cpu_cvb_tables); i++) {
+			table = &tegra210_cpu_cvb_tables[i];
+			if (table->speedo_id == speedo_id &&
+			    table->max_millivolts < TEGRA210_CPU_OC_MAX_MV)
+				table->max_millivolts = TEGRA210_CPU_OC_MAX_MV;
+		}
+		dev_info(&pdev->dev, "CPU clock up to %lu kHz, %d mV\n",
+			 soc->max_freq / 1000, TEGRA210_CPU_OC_MAX_MV);
+	}
+
 	soc->cvb = tegra_cvb_add_opp_table(soc->dev, fcpu_data->cpu_cvb_tables,
 					   fcpu_data->cpu_cvb_tables_size,
 					   &align, process_id, speedo_id,
