# linux-nano: Arch Linux ARM's linux-aarch64 7.2.11-1 for the NVIDIA Jetson Nano (Tegra210),
# plus a small config fragment (config.nano), a Tegra210 EMC patch (0101), a tegra-drm patch
# (0102) so the display accepts NVIDIA's canonical block-linear modifiers, and an xhci-tegra fix
# (0103) so a reboot no longer faults (SError) in the USB controller's mailbox interrupt, and two
# fixes for errors logged at every boot: the AGIC's smp_processor_id() (0104) and a Bluetooth
# query that older Intel controllers refuse (0105). 0106 lets nvgpu-nano clamp the GPU rail,
# 0107 and 0109 make suspend (SC7) work, 0108 quiets a USB supply warning, 0110 fixes a workqueue stall
# after a suspend (the GPU's frequency stayed stuck), 0111 the power sensor's I2C bus after a suspend.
# 0112 adds an optional parameter for higher CPU clocks (off by default), 0113 stops the PMIC watchdog
# during suspend (it reset the board after a minute),
# 0114 keeps the firmware's UART clocked (the first suspend after a boot hung), 0115 gives the memory its
# full speed back after a suspend.
# Fork kevin03L/jetson-nano-omarchy (branch j202): also builds the reComputer J1020 v2 device tree
# (tegra210-p3448-0002-j202.dtb). scripts/cross-build-linux-nano.sh builds this PKGBUILD on x86.
#
# Derived from Arch Linux ARM PKGBUILDs core/linux-aarch64 at commit b7704835b
# ("core/linux-aarch64 to 7.2.11-1"), maintained by Kevin Mihelich and graysky; patches
# 0001-0005, config and linux.preset are theirs, unchanged except the preset image name.
# Installs next to linux-aarch64 (own image, initramfs and module directory), so the stock
# kernel stays available as a boot fallback.

buildarch=8

pkgbase=linux-nano
_srcname=linux-7.2
_desc="NVIDIA Jetson Nano (Tegra210), based on ALARM linux-aarch64"
pkgver=7.2.11
pkgrel=7
arch=('aarch64')
url="https://github.com/Kristianaaron/jetson-nano-omarchy"
license=('GPL-2.0-only')
makedepends=('xmlto' 'docbook-xsl' 'kmod' 'inetutils' 'bc' 'git' 'dtc' 'python')
options=('!strip')
source=("https://www.kernel.org/pub/linux/kernel/v7.x/${_srcname}.tar.xz"
