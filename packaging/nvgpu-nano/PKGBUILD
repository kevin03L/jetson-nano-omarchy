# nvgpu-nano: NVIDIA's L4T R36 GPU driver (nvgpu) and memory manager (nvmap), ported to mainline
# Linux 7.2 for the Jetson Nano's GM20B GPU, built for linux-nano. With it, CUDA 12, Vulkan and
# the desktop (Mesa Zink on NVIDIA's Vulkan driver) share one driver stack.
#
# Sources: Kristianaaron/linux-nvgpu and Kristianaaron/linux-nv-oot, branch mainline-7.2, forks
# of OE4T's mirrors of NVIDIA's R36 code (GPL-2.0), pinned by commit. The 0001 patch is
# linux-nvgpu commit cd6890c (the GPC clock registered without a device: a clock-framework /
# runtime-PM deadlock with pwm-tegra hung boots), carried here until it is in the fork. 0002 retries
# a failed FECS firmware start instead of hanging until the hung-task panic.
#
# Boot modes: nouveau and nvgpu both bind the GPU. The CUDA boot entry blacklists nouveau
# (modprobe.blacklist=nouveau nano.mode=cuda) and nvgpu loads by its device-tree alias; the
# nouveau entry must blacklist nvgpu (modprobe.blacklist=nvgpu).
pkgname=nvgpu-nano
_kernver=7.2.11-4-nano-ARCH
_nvgpu=b2e06416fca6bc40925d3e8cb3dba4033778e555
_nvoot=9ca0e7c617c1648a21033bf2e9f90f9789fb6379
pkgver=36.4.20261121
pkgrel=3
pkgdesc="NVIDIA nvgpu and nvmap kernel drivers for the Jetson Nano GPU on linux-nano"
arch=(aarch64)
url="https://github.com/Kristianaaron/jetson-nano-omarchy"
license=(GPL-2.0-only)
depends=('linux-nano=7.2.11-4' nvidia-l4t-gm20b-firmware nvidia-l4t-r36 mesa)
makedepends=('linux-nano-headers=7.2.11-4' git bc)
options=(!strip !debug)
source=("linux-nvgpu::git+https://github.com/Kristianaaron/linux-nvgpu.git#commit=$_nvgpu"
        "linux-nv-oot::git+https://github.com/Kristianaaron/linux-nv-oot.git#commit=$_nvoot"
        nvgpu-nano.conf
        70-nvgpu-nano.rules
        60-nvgpu-nano-env
        0001-nvgpu-gm20b-register-the-GPC-clock-without-a-device.patch
        0002-nvgpu-gr-retry-FECS-init-and-do-not-wait-for-it-from-itself.patch)
sha256sums=('SKIP'
            'SKIP'
            'd8f88234ce72e53148cbba238dd7443816d9bf932a1eebdc4306e5d88b1f74bc'
            'd757edc2d778720dd2d577b1efc98ff05e5a65c2e67ab59b731ae03a89b563e1'
            '919685d834f22d247454e6b24ff5c925987072a5fa5d432bb88f13e4e2b1ef7f'
            '9c35bbb1eabadd878378ed143cf236f3d95884b4bf532dc5c76e2d17da2448c2'
            '888d0756d8a5cd8cb02e0e2d2a90c2f64871200460603298222d6b82cff6ba3a')

_kdir=/usr/lib/modules/$_kernver/build

prepare() {
  git -C linux-nvgpu apply "$srcdir/0001-nvgpu-gm20b-register-the-GPC-clock-without-a-device.patch"
  git -C linux-nvgpu apply "$srcdir/0002-nvgpu-gr-retry-FECS-init-and-do-not-wait-for-it-from-itself.patch"
}

build() {
  local conf="$srcdir/conftest" oot="$srcdir/linux-nv-oot"

  # 1. conftest: probe the kernel API, as JetPack builds NVIDIA's out-of-tree drivers.
  rm -rf "$conf" && mkdir -p "$conf/nvidia"
  cp -a "$oot/scripts/conftest/." "$conf/nvidia/"
  make -j"$(nproc)" ARCH=arm64 -C "$_kdir" src="$conf/nvidia" obj="$conf/nvidia" \
    NV_KERNEL_SOURCES="$_kdir" NV_KERNEL_OUTPUT="$_kdir" -f "$conf/nvidia/Makefile"

  # 2. nvmap without NvSciIpc (no IVC on Tegra210).
  make -j"$(nproc)" ARCH=arm64 -C "$_kdir" M="$oot/drivers/video/tegra/nvmap" \
    CONFIG_TEGRA_OOT_MODULE=m NVMAP_CONFIG_SCIIPC=n \
    srctree.nvidia-oot="$oot" srctree.nvconftest="$conf" KCFLAGS="-I$conf -I$oot/include" \
    modules

  # 3. nvgpu with NVIDIA's default feature set, minus what mainline Tegra210 lacks: nv-oot's
  #    host1x-next and nvmap-next (mainline host1x serves tegra-drm), VPR, Tegra234 mc-utils;
  #    fuses through tegra_fuse_readl() instead of NVMEM cells.
  make -j"$(nproc)" ARCH=arm64 -C "$_kdir" M="$srcdir/linux-nvgpu/drivers/gpu/nvgpu" \
    CONFIG_TEGRA_OOT_MODULE=m srctree.nvidia="$oot" srctree.nvconftest="$conf" \
    CONFIG_TEGRA_HOST1X_NEXT= CONFIG_TEGRA_NVMAP_NEXT= \
    CONFIG_NVGPU_VPR= CONFIG_NVGPU_TEGRA_MC_UTILS= CONFIG_NVGPU_NVMEM_FUSE=n \
    modules
}

package() {
  local m="$pkgdir/usr/lib/modules/$_kernver/extramodules"
  install -Dm644 linux-nv-oot/drivers/video/tegra/nvmap/nvmap.ko "$m/nvmap.ko"
  install -Dm644 linux-nvgpu/drivers/gpu/nvgpu/nvgpu.ko "$m/nvgpu.ko"

  install -Dm644 nvgpu-nano.conf "$pkgdir/usr/lib/modprobe.d/nvgpu-nano.conf"
  install -Dm644 70-nvgpu-nano.rules "$pkgdir/usr/lib/udev/rules.d/70-nvgpu-nano.rules"
  install -Dm755 60-nvgpu-nano-env "$pkgdir/usr/lib/systemd/system-environment-generators/60-nvgpu-nano-env"
  install -d "$pkgdir/usr/lib/systemd/user-environment-generators"
  ln -s ../system-environment-generators/60-nvgpu-nano-env \
    "$pkgdir/usr/lib/systemd/user-environment-generators/60-nvgpu-nano-env"
}
