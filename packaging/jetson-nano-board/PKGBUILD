# jetson-nano-board: Jetson Nano (Tegra210, B01) board policy for linux-nano systems: GPU clock
# floor and fan start point applied by udev when the devices appear, the guarded memory-clock
# raise to 1600 MHz, and a memory-pressure policy for 4 GB: the desktop session keeps its memory,
# systemd-oomd acts within seconds on the app that causes pressure, and the session survives one
# helper being killed. The micro-USB port is a USB device for a host computer (network and serial
# console, as NVIDIA's l4t-devmode), up early in boot. Self-recovery: a driver deadlock panics and
# reboots (hung_task_panic), the PMIC watchdog resets a frozen system or a hung reboot, and a boot
# guard (enabled separately) falls back to a safe boot entry after a boot that does not come up.
pkgname=jetson-nano-board
pkgver=1
pkgrel=8
pkgdesc="Jetson Nano board policy: GPU clock floor, fan trip point, memory clock raise, memory pressure policy, micro-USB host link"
arch=(any)
url="https://github.com/Kristianaaron/jetson-nano-omarchy"
license=(MIT)
depends=(systemd kmod iproute2)
install=jetson-nano-board.install
source=(80-jetson-nano-board.rules fan-trip emc-raise jetson-nano-emc.service 10-jetson-nano-oom.conf
        10-jetson-nano-oomd.conf 10-jetson-nano-memory.slice.conf 10-jetson-nano-memory.service.conf 10-jetson-nano-session.slice.conf
        usb-gadget jetson-nano-usb-gadget.service 10-jetson-nano-usb-gadget.nm.conf
        10-jetson-nano-watchdog.conf jetson-nano-watchdog.modules 10-jetson-nano-hung-task.sysctl boot-guard jetson-nano-boot-guard.service jetson-nano-boot-ok.service
        power-limit jetson-nano-power.service power.conf.example jetson-nano-mglru.tmpfiles)
