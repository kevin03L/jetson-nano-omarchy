package() {
  install -Dm644 80-jetson-nano-board.rules "$pkgdir/usr/lib/udev/rules.d/80-jetson-nano-board.rules"
  install -Dm755 fan-trip "$pkgdir/usr/lib/jetson-nano/fan-trip"
  install -Dm755 emc-raise "$pkgdir/usr/lib/jetson-nano/emc-raise"
  install -Dm644 jetson-nano-emc.service "$pkgdir/usr/lib/systemd/system/jetson-nano-emc.service"
  install -Dm644 10-jetson-nano-oom.conf \
    "$pkgdir/usr/lib/systemd/user/wayland-wm@.service.d/10-jetson-nano-oom.conf"
  install -Dm644 10-jetson-nano-oomd.conf "$pkgdir/usr/lib/systemd/oomd.conf.d/20-jetson-nano.conf"
  install -Dm644 10-jetson-nano-memory.slice.conf \
    "$pkgdir/usr/lib/systemd/system/user.slice.d/10-jetson-nano-memory.conf"
  install -Dm644 10-jetson-nano-memory.slice.conf \
    "$pkgdir/usr/lib/systemd/system/user-.slice.d/10-jetson-nano-memory.conf"
  install -Dm644 10-jetson-nano-memory.service.conf \
    "$pkgdir/usr/lib/systemd/system/user@.service.d/10-jetson-nano-memory.conf"
  install -Dm644 10-jetson-nano-session.slice.conf \
    "$pkgdir/usr/lib/systemd/user/session.slice.d/10-jetson-nano-memory.conf"
  install -Dm755 usb-gadget "$pkgdir/usr/lib/jetson-nano/usb-gadget"
  install -Dm644 jetson-nano-usb-gadget.service \
    "$pkgdir/usr/lib/systemd/system/jetson-nano-usb-gadget.service"
  install -Dm644 10-jetson-nano-ttyGS0.conf     "$pkgdir/usr/lib/systemd/system/serial-getty@ttyGS0.service.d/10-jetson-nano.conf"
  install -Dm644 10-jetson-nano-usb-gadget.nm.conf \
    "$pkgdir/usr/lib/NetworkManager/conf.d/10-jetson-nano-usb-gadget.conf"
  install -Dm644 10-jetson-nano-watchdog.conf "$pkgdir/usr/lib/systemd/system.conf.d/10-jetson-nano-watchdog.conf"
  install -Dm644 jetson-nano-watchdog.modules "$pkgdir/usr/lib/modules-load.d/jetson-nano-watchdog.conf"
  install -Dm644 10-jetson-nano-hung-task.sysctl "$pkgdir/usr/lib/sysctl.d/10-jetson-nano-hung-task.conf"
  install -Dm755 boot-guard "$pkgdir/usr/lib/jetson-nano/boot-guard"
  install -Dm644 jetson-nano-boot-guard.service "$pkgdir/usr/lib/systemd/system/jetson-nano-boot-guard.service"
  install -Dm644 jetson-nano-boot-ok.service "$pkgdir/usr/lib/systemd/system/jetson-nano-boot-ok.service"
  install -Dm755 power-limit "$pkgdir/usr/lib/jetson-nano/power-limit"
  install -Dm644 jetson-nano-power.service "$pkgdir/usr/lib/systemd/system/jetson-nano-power.service"
  install -Dm644 power.conf.example "$pkgdir/usr/share/jetson-nano/power.conf.example"
  install -Dm755 jetson-nano-mode "$pkgdir/usr/bin/jetson-nano-mode"
  install -Dm644 modes "$pkgdir/usr/lib/jetson-nano/modes"
  install -Dm755 mode-set "$pkgdir/usr/lib/jetson-nano/mode-set"
  install -Dm644 org.jetsonnano.mode.policy "$pkgdir/usr/share/polkit-1/actions/org.jetsonnano.mode.policy"
  install -Dm644 jetson-nano-mode.desktop "$pkgdir/usr/share/applications/jetson-nano-mode.desktop"
  install -Dm755 keep-kernel "$pkgdir/usr/lib/jetson-nano/keep-kernel"
  install -Dm644 -t "$pkgdir/usr/share/libalpm/hooks" 10-jetson-nano-keep-kernel.hook 90-jetson-nano-keep-kernel.hook
  install -Dm644 jetson-nano-usb-gadget-down.service "$pkgdir/usr/lib/systemd/system/jetson-nano-usb-gadget-down.service"
  # Omarchy bar widget: copy it to ~/.config/omarchy/plugins/ (docs/j202-plan.md)
  install -Dm644 bar-manifest.json "$pkgdir/usr/share/jetson-nano/bar/jetson.power-mode/manifest.json"
  install -Dm644 PowerMode.qml "$pkgdir/usr/share/jetson-nano/bar/jetson.power-mode/PowerMode.qml"
  install -Dm755 rtc-clock "$pkgdir/usr/lib/jetson-nano/rtc-clock"
  install -Dm644 rtc.conf.example "$pkgdir/usr/share/jetson-nano/rtc.conf.example"
  install -Dm644 -t "$pkgdir/usr/lib/systemd/system" jetson-nano-rtc.service jetson-nano-rtc-save.service jetson-nano-rtc-save.timer
  install -Dm755 fan-curve "$pkgdir/usr/lib/jetson-nano/fan-curve"
  install -Dm644 jetson-nano-fan-curve.service "$pkgdir/usr/lib/systemd/system/jetson-nano-fan-curve.service"
  install -Dm644 fan.conf.example "$pkgdir/usr/share/jetson-nano/fan.conf.example"
  install -Dm644 jetson-nano-mglru.tmpfiles "$pkgdir/usr/lib/tmpfiles.d/jetson-nano-mglru.conf"
}
